# VoiceIndia — copy to .env for local development (never commit .env)
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# reCAPTCHA v3 (Google) — VITE_ prefix required for browser access
# Use the same value as the "recapcha_key" variable in Netlify dashboard
VITE_RECAPTCHA_KEY=your_recaptcha_site_key

# NOTE: The secret key goes into Netlify as "recaptha_secreate" (not in this file)
# It is never exposed to the browser.

# HubSpot — Support / Help form
# Both values come from the embed snippet:
#   <script src="https://js-na2.hsforms.net/forms/embed/{PORTAL_ID}.js" defer></script>
#   <div class="hs-form-frame" data-form-id="{FORM_ID}" data-portal-id="{PORTAL_ID}"></div>
VITE_HUBSPOT_PORTAL_ID=244822982
VITE_HUBSPOT_FORM_ID=aa3482c3-cf8d-4ce8-8360-5cced50b1083
